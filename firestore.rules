
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role based on email.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@8bit.com';
    }

    // --- Public Access for Customer Operations ---
    // Anyone can read and register. Only admins can edit/delete players.
    match /players/{playerId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Anyone can read games and events. Only admins can manage them.
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anyone can see the leaderboard and submit scores. Only admins can manage them.
    match /scoreSubmissions/{scoreSubmissionId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Anyone can use the FIFA tracker. Only admins can edit match history.
    match /fifaMatches/{matchId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Anyone can manage FIFA sessions (start/end). Only admins can delete sessions.
    match /fifaSessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Config and Offers
    match /config/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{userId} {
      allow read, write: if false;
    }
  }
}
