
{
  "entities": {
    "Player": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Player",
      "type": "object",
      "description": "Represents a participant in the retro gaming event who registers and submits scores.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "instagramHandle": { "type": "string" },
        "groupSize": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "eventId": { "type": "string" },
        "eventName": { "type": "string" }
      },
      "required": ["id", "name", "groupSize", "createdAt"]
    },
    "FifaMatch": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FifaMatch",
      "type": "object",
      "description": "Represents a FIFA match result between two players.",
      "properties": {
        "id": { "type": "string" },
        "player1Id": { "type": "string" },
        "player1Name": { "type": "string" },
        "player1Team": { "type": "string" },
        "player1Score": { "type": "number" },
        "player2Id": { "type": "string" },
        "player2Name": { "type": "string" },
        "player2Team": { "type": "string" },
        "player2Score": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "player1Id", "player1Name", "player1Score", "player2Id", "player2Name", "player2Score", "timestamp"]
    }
  },
  "auth": {
    "providers": ["email", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/players/{playerId}",
        "definition": { "entityName": "Player" }
      },
      {
        "path": "/fifaMatches/{matchId}",
        "definition": { "entityName": "FifaMatch" }
      }
    ]
  }
}
